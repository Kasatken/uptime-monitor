# --- server ---
API_PORT=3000
# Public URL of the app, used in alert links and heartbeat URLs
APP_URL=http://localhost:5173

# --- auth (single owner) ---
ADMIN_PASSWORD=change-me-please
# openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# --- database ---
# Leave empty to use embedded Postgres (PGlite) stored in PGLITE_DIR.
# Set it when you run a real Postgres, e.g. postgres://vigil:vigil@localhost:5432/vigil
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# --- checks ---
CHECK_CONCURRENCY=10
CHECK_RETENTION_DAYS=30

# --- status page ---
STATUS_PAGE_TITLE=Vigil Status

# --- alerts (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack / Discord / any endpoint that accepts JSON
ALERT_WEBHOOK_URL=
